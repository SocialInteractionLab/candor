knitr::opts_knit$set(root.dir = "/Users/tuo70125/My Drive/SANLab/Experiments/Dissertation/Analysis")}
# packages
library(Rmisc)           # summary statistics
library(widyr)           # pairwise similarity calculations
library(lattice)         # multivariate graphing
library(EnvStats)        # functions for graphing and stats
library(patchwork)       # combine plots
library(lme4)            # multilevel models
library(lmerTest)        # add ons for MLMs
library(ggeffects)       # model predictions
library(ggrepel)         # repel labels
library(psych)           # all things psych
library(skimr)           # skim data
library(nFactors)        # PCA statistics
library(ggforce)         # clustering shading
library(broom)           # tidy t-test output
library(sjPlot)          # model summaries
library(emmeans)         # model contrasts
library(interactions)    # interactions for models
library(randomForest)    # random forest modeling
library(metap)           # fisher's method for p adjustments
library(glue)            # glue messages
library(performance)     # modeling quality checks
library(modelsummary)    # output model summary tables
library(tidyverse)       # all tidy things (ggplot, dplyr, etc.)
# set plot theme
theme_diss <- function() {
theme_classic() %+replace%
theme(
# axes
axis.title = element_text(size = 20, face = "bold", family = "sans"),
axis.text = element_text(size = 14, family = "sans"),
# legend
legend.title = element_text(size = 16, face = "bold", family = "sans"),
legend.text = element_text(size = 14, family = "sans"),
# title
plot.title = element_text(size = 24, family = "sans", face = "bold", hjust = 0.5)) }
# set colors
emotion_colors <- c("#6b2b1b","#b75044", "#e1914e", "#eec773", "#93b693", "#1e475c")
model_colors <- c("#b75044", "#eec773", "#1e475c")
neutrals <- c("#e6e6e3", "#d9d9d6", "#bfbfbc", "#8c8c89")
matrix.colors <- c("#1e475c", "white", "#b75044")
# load data
df_raw <- list.files(
"/Volumes/Psychology/Helion_Group/studies/CAL_dynamics/data/AD-pilot/raw",
pattern = "\\.csv$",
full.names = TRUE) |>
map_dfr(
~ suppressMessages(
read_csv(.x,
col_types = cols(subject_id = col_character(),
.default = col_guess())) |>
mutate(PID = sub(".*pilot_([^_]+)_.*", "\\1", basename(.x))) |>
relocate(PID, .before = 1)))
## can ignore warning: problem closing connection: bad file descriptor message
## r sometimes just complains that I opened and closed a lot of files at once
# create participant info data frame
df_info <- df_raw |>
select(PID, task, response, screening_id, rating_type) |>
filter(task %in% c("screening", "consent", "practice", "attention check"))
# add source based on PID
# PID length 6 = SONA, otherwise, Prolific
df_info <- df_info |>
mutate(source = ifelse(nchar(PID) == 6, "SONA", "PROLIFIC"))
# get average age and mean age per source
df_info |>
filter(screening_id == "age") |>
mutate(response = as.numeric(sub('.*"age":"([0-9]+)".*', '\\1', response))) %>%
{bind_rows(summarize(., mean_age = mean(response, na.rm = TRUE),
sd_age = sd(response, na.rm = TRUE), source = "overall"),
summarize(., mean_age = mean(response, na.rm = TRUE),
sd_age = sd(response, na.rm = TRUE), .by = source))}
# print split of SONA and Prolific participants so far
df_info |>
distinct(PID, source) |>
count(source)
# did anyone not consent? (pass: task = consent, response = 0)
df_info |>
filter(task == "consent", response == 1) |>
print()
# did anyone not pass attention checks?
# (pass: task = attention check, response != Cookie)
df_info |>
filter(task == "attention check") |>
# mutate response to validate
mutate(response = sub('.*:"([^"]+)".*', '\\1', response)) |>
filter(response != "Cookie") |>
print()
# what about practice rating attention checks?
# (pass: task = practice, rating_type = practice left, right, or middle,
#  response is not where they were told to place along the sliding scale)
df_info |>
filter(task == "practice") |>
filter((rating_type == "practice left" & as.numeric(response) > 50) |
(rating_type == "practice right" & as.numeric(response) < 50) |
(rating_type == "practice middle" & !(as.numeric(response) >= 25 &
as.numeric(response) <= 75))) |>
print()
# only keep rows where participants are rating
df <- df_raw |>
filter(trial_type == "html-slider-response") |>
# separate out practice ratings
filter(!rating_type %in% c("practice left",
"practice right",
"practice middle")) |>
select(PID, trial_index, task, rt, response, rating_type)
# change trial index to start at 1 for each participant
# currently starts at 19
# do this separately for SONA and PROLIFIC
# df <- df |>
#   mutate(trial_index = trial_index - 18)
# rename columns
names(df) <- c("PID", "trial_index", "emotion_word", "rt", "rating", "dimension")
# make "null" values into NA for rt and ratings
df$rt <- ifelse(df$rt == "null", NA, df$rt)
df$rating <- ifelse(df$rating == "null", NA, df$rating)
# ensure reaction time, trial index, and rating are numeric
df$trial_index <- as.numeric(df$trial_index)
df$rt <- as.numeric(df$rt)
df$rating <- as.numeric(df$rating)
# preview
head(df)
# how many trials did each participant miss (count and % of total)
# 28 words x 29 dimensions = 812
trial_count <- max(df$trial_index) - min(df$trial_index)
# exclude participants who miss > 20% of trials
df |>
group_by(PID) |>
summarize(n_NA = sum(is.na(rating)),
pct_NA = 100 * n_NA / trial_count) |>
arrange(-pct_NA)
# list of participants to exclude and reasons
# reasons could be not passing attention check, >20% of missed trials
# PID =   673f808c15c34271ac88d58e, reason = 46.8% of trials missed
# PID =   695fd32d57ab13beb1653fc9, reason = 56.9% of trials missed
# PID =   67f06192529886aa3bddd0b6, reason = sped through task (25 min total; median time to complete is 52 min)
# PID =   5685850c333cbd000d4e042f, reason = 40.6% of trials missed
# PID =   6938b3a102d6dfae6c72a140, reason = 55.4% of trials missed
# PID =   682cd328bd53185cbbb59840, reason = 81.3% of trials missed
# PID =   6650a07f83dde5b6da54d674, reason = 77.0% of trials missed
pid_exclude <- c("673f808c15c34271ac88d58e", "695fd32d57ab13beb1653fc9",
"67f06192529886aa3bddd0b6", "5685850c333cbd000d4e042f",
"6938b3a102d6dfae6c72a140", "682cd328bd53185cbbb59840",
"6650a07f83dde5b6da54d674")
# exclude from df
df <- df |>
filter(!PID %in% pid_exclude)
# print age and counts after exclusions
df_info |>
filter(!PID %in% pid_exclude) |>
filter(screening_id == "age") |>
mutate(response = as.numeric(sub('.*"age":"([0-9]+)".*', '\\1', response))) %>%
{bind_rows(summarize(., mean_age = mean(response, na.rm = TRUE),
sd_age = sd(response, na.rm = TRUE), source = "overall"),
summarize(., mean_age = mean(response, na.rm = TRUE),
sd_age = sd(response, na.rm = TRUE), .by = source))}
df_info |>
filter(!PID %in% pid_exclude) |>
distinct(PID, source) |>
count(source)
